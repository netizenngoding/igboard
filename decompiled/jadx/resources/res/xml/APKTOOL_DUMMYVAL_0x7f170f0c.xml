<?xml version="1.0" encoding="utf-8"?>
<framework>
    <softkeys>
        <softkey_template
            alpha="$icon_alpha$"
            content_description="$desc$"
            disable_lift_to_tap="true"
            id="@+id/APKTOOL_DUMMYVAL_0x7f0b261b"
            layout="$layout$"
            long_press_delay="500">
            <action
                data="$param_data$"
                intention="$intention$"
                keycode="$keycode=IME_ACTION$"
                type="PRESS"/>
            <icon
                location="@+id/APKTOOL_DUMMYVAL_0x7f0b03c2"
                value="$param_icon$"/>
        </softkey_template>
    </softkeys>
</framework>
