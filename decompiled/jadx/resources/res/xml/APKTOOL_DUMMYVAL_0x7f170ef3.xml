<?xml version="1.0" encoding="utf-8"?>
<framework>
    <softkeys>
        <softkey_list splitter=",">
            <softkey_template
                content_description="$desc$"
                id="@+id/APKTOOL_DUMMYVAL_0x7f0b2685"
                layout="@layout/APKTOOL_DUMMYVAL_0x7f0e076c"
                multi_touch="false"
                popup_timing="@string/APKTOOL_DUMMYVAL_0x7f140ae8"
                slide_sensitivity="NORMAL">
                <action
                    data="$press_data$"
                    intention="$press_intent=DECODE$"
                    keycode="ALPHABET"
                    popup_label="$press_data$"
                    type="PRESS"/>
                <action
                    data="$long_press_data$"
                    intention="$long_press_intention=DECODE$"
                    keycode="ALPHABET"
                    merge_insertion_index="$merge_index=0$"
                    popup_label="$long_press_data$"
                    popup_layout="@layout/APKTOOL_DUMMYVAL_0x7f0e0622"
                    type="LONG_PRESS"/>
                <label
                    location="@+id/APKTOOL_DUMMYVAL_0x7f0b05f5"
                    value="$press_data$"/>
            </softkey_template>
        </softkey_list>
    </softkeys>
</framework>
