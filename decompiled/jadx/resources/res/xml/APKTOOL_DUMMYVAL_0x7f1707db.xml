<?xml version="1.0" encoding="utf-8"?>
<framework>
    <keyboard>
        <if
            device="tablet"
            device_size="large"
            keyboard_mode="normal">
            <view
                layout="@layout/APKTOOL_DUMMYVAL_0x7f0e03c7"
                type="body"/>
        </if>
        <else_if keyboard_mode="split">
            <if split_with_duplicate_keys="true">
                <view
                    layout="@layout/APKTOOL_DUMMYVAL_0x7f0e03a3"
                    type="body"/>
            </if>
            <else>
                <view
                    layout="@layout/APKTOOL_DUMMYVAL_0x7f0e03a4"
                    type="body"/>
