<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/APKTOOL_DUMMYVAL_0x7f1503a1">
    <ImageView style="@style/APKTOOL_DUMMYVAL_0x7f15039c"/>
    <LinearLayout style="@style/APKTOOL_DUMMYVAL_0x7f15044f">
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView
            android:id="@+id/key_pos_undo"
            android:layout_weight="250"
            style="@style/APKTOOL_DUMMYVAL_0x7f150710"/>
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView
            android:id="@+id/key_pos_left_arrow"
            android:layout_weight="250"
            style="@style/APKTOOL_DUMMYVAL_0x7f150710"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="250">
            <com.google.android.libraries.inputmethod.widgets.SoftKeyView
                android:id="@+id/key_pos_switch_to_symbol"
                android:visibility="gone"
                android:layout_weight="100"
                style="@style/APKTOOL_DUMMYVAL_0x7f150715"/>
            <com.google.android.libraries.inputmethod.widgets.SoftKeyView
                android:id="@+id/key_pos_switch_to_smiley"
                android:visibility="gone"
                android:layout_weight="100"
                style="@style/APKTOOL_DUMMYVAL_0x7f150715"/>
        </LinearLayout>
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView
            android:id="@+id/key_pos_switch_hiragana_alphabet"
            android:layout_weight="250"
            style="@style/APKTOOL_DUMMYVAL_0x7f150712"/>
    </LinearLayout>
</FrameLayout>
