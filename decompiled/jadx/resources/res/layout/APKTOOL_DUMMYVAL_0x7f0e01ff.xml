        android:layout_height="match_parent"
        android:layout_margin="@dimen/APKTOOL_DUMMYVAL_0x7f070098">
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView
            android:layout_gravity="top|center_horizontal"
