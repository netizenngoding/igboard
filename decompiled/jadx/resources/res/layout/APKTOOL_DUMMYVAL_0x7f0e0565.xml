<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:tag=".translate.language_entry"
    android:background="@drawable/APKTOOL_DUMMYVAL_0x7f080349"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?android:attr/selectableItemBackground">
    <ImageView
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b29dc"
        android:tag=".translate.language_entry.indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/APKTOOL_DUMMYVAL_0x7f0806ad"
        android:importantForAccessibility="no"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="12dp"/>
    <com.google.android.libraries.inputmethod.widgets.text.MarqueeTextView
        android:textSize="20sp"
        android:gravity="center_vertical"
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b29dd"
        android:tag=".label.translate.language_entry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:layout_weight="1"/>
    <ImageView
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b29de"
        android:tag=".translate.language_entry.indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:layout_marginEnd="24dp"/>
    <View
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b07d4"
        android:tag=".translate.language.separator"
        android:background="#ffffffff"
        android:layout_width="128dp"
        android:layout_height="2dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"/>
</LinearLayout>
