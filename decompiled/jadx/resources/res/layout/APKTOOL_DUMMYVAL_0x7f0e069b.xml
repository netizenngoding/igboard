            android:layout_weight="1"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="16dp"/>
        <com.google.android.apps.inputmethod.libs.languageselection.preference.LanguageSpecificSettingBottomButtonsWrapper
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2">
            <Button
                android:ellipsize="marquee"
                android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b0619"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/APKTOOL_DUMMYVAL_0x7f1404f4"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:textAllCaps="false"
                android:layout_marginEnd="16dp"
                app:APKTOOL_DUMMYVAL_0x7f040665="?attr/APKTOOL_DUMMYVAL_0x7f04015e"
                style="?attr/APKTOOL_DUMMYVAL_0x7f0407c5"/>
            <Button
                android:ellipsize="marquee"
                android:id="@+id/language_specific_setting_done_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/APKTOOL_DUMMYVAL_0x7f1404fa"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:textAllCaps="false"
                android:layout_marginEnd="16dp"
                app:APKTOOL_DUMMYVAL_0x7f040665="?attr/APKTOOL_DUMMYVAL_0x7f04015e"/>
        </com.google.android.apps.inputmethod.libs.languageselection.preference.LanguageSpecificSettingBottomButtonsWrapper>
    </LinearLayout>
</FrameLayout>
