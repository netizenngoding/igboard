<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b0613"
    android:background="?attr/APKTOOL_DUMMYVAL_0x7f0404ea"
    android:layout_width="match_parent"
    android:layout_height="65dp">
    <View
        android:layout_gravity="top"
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b061c"
        android:background="?attr/APKTOOL_DUMMYVAL_0x7f0404cb"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="1dp">
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/APKTOOL_DUMMYVAL_0x7f0404bd"
            android:ellipsize="end"
            android:gravity="start"
            android:layout_gravity="center_vertical"
            android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b061b"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/APKTOOL_DUMMYVAL_0x7f140502"
