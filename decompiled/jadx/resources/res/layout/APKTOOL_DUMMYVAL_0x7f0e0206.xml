<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="?attr/APKTOOL_DUMMYVAL_0x7f0401e3">
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView
            android:id="@+id/key_pos_punctuation_1"
            android:layout_weight="175"
            style="@style/APKTOOL_DUMMYVAL_0x7f1506c2"/>
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView
            android:id="@+id/key_pos_punctuation_2"
            android:layout_weight="175"
            style="@style/APKTOOL_DUMMYVAL_0x7f1506c2"/>
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView
            android:id="@+id/key_pos_punctuation_3"
            android:layout_weight="175"
            style="@style/APKTOOL_DUMMYVAL_0x7f1506c2"/>
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView
            android:id="@+id/key_pos_punctuation_4"
            android:layout_weight="175"
            style="@style/APKTOOL_DUMMYVAL_0x7f1506c2"/>
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView
            android:id="@+id/key_pos_punctuation_5"
            android:layout_weight="175"
            style="@style/APKTOOL_DUMMYVAL_0x7f1506c2"/>
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView
            android:id="@+id/key_pos_punctuation_6"
            android:layout_weight="175"
            style="@style/APKTOOL_DUMMYVAL_0x7f1506c2"/>
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView
            android:id="@+id/key_pos_punctuation_7"
            android:layout_weight="175"
            style="@style/APKTOOL_DUMMYVAL_0x7f1506c2"/>
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView
            android:id="@+id/key_pos_punctuation_8"
            android:layout_weight="175"
            style="@style/APKTOOL_DUMMYVAL_0x7f1506c2"/>
    </LinearLayout>
    <LinearLayout
        android:weightSum="@integer/APKTOOL_DUMMYVAL_0x7f0c00fb"
        style="@style/APKTOOL_DUMMYVAL_0x7f1501f3">
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView
            android:id="@+id/key_pos_switch_to_symbol"
            android:layout_weight="150"
            style="@style/APKTOOL_DUMMYVAL_0x7f1506e5"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="475">
            <com.google.android.libraries.inputmethod.widgets.SoftKeyView
                android:id="@+id/key_pos_switch_to_smiley"
                android:visibility="gone"
                android:layout_weight="100"
                style="@style/APKTOOL_DUMMYVAL_0x7f1506e5"/>
            <com.google.android.libraries.inputmethod.widgets.SoftKeyView
                android:id="@+id/key_pos_switch_to_next_language"
                android:visibility="gone"
                android:layout_weight="100"
                style="@style/APKTOOL_DUMMYVAL_0x7f1506e4"/>
            <com.google.android.libraries.inputmethod.widgets.SoftKeyView
                android:id="@+id/key_pos_space"
                android:layout_weight="275"
                style="@style/APKTOOL_DUMMYVAL_0x7f1506f1"/>
        </LinearLayout>
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView
            android:id="@+id/key_pos_toggle_fullscreen"
            android:layout_weight="100"
            style="@style/APKTOOL_DUMMYVAL_0x7f1506e4"/>
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView
            android:id="@+id/key_pos_del"
            android:layout_weight="125"
            style="@style/APKTOOL_DUMMYVAL_0x7f1506e5"/>
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView
            android:id="@+id/key_pos_ime_action"
            android:layout_weight="150"
            style="@style/APKTOOL_DUMMYVAL_0x7f1506ec"/>
    </LinearLayout>
</LinearLayout>
