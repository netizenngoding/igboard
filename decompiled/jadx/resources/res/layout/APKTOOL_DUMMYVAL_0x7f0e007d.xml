                            android:layout_gravity="center"
                            android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b0767"
                            android:tag=".content-suggestion-primary-color"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="3"
                            android:breakStrategy="balanced"
                            style="@style/APKTOOL_DUMMYVAL_0x7f150521"/>
                        <TextView
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b0769"
                            android:padding="8dp"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/APKTOOL_DUMMYVAL_0x7f140512"
                            android:maxLines="1"
                            style="@style/APKTOOL_DUMMYVAL_0x7f150522"/>
