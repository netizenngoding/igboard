<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="top"
    android:orientation="vertical"
    android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b01e4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/APKTOOL_DUMMYVAL_0x7f15079d">
    <FrameLayout
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b026a"
        android:paddingLeft="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.google.android.libraries.inputmethod.contentsuggestion.resource.ContentSuggestionBodyContainer
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b025d"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ViewSwitcher
            android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b0762"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b0761"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b06da"
                    android:layout_width="@dimen/APKTOOL_DUMMYVAL_0x7f0700a0"
                    android:layout_height="@dimen/APKTOOL_DUMMYVAL_0x7f0700a0"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:layout_gravity="end|top"
                        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b06d9"
                        android:tag=".content-suggestion-primary-color"
                        android:layout_width="@dimen/APKTOOL_DUMMYVAL_0x7f0700e8"
                        android:layout_height="@dimen/APKTOOL_DUMMYVAL_0x7f0700e8"
                        android:layout_margin="8dp"
                        android:scaleType="centerInside"
                        android:importantForAccessibility="no"/>
                </FrameLayout>
                <ImageView
                    android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b0760"
                    android:tag=".content-suggestion-primary-color"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:layout_centerInParent="true"
                    android:alpha="0.4"
                    android:importantForAccessibility="no"/>
                <LinearLayout
