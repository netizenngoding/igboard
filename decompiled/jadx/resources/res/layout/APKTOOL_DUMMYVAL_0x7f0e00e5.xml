<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:duplicateParentState="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b03c2"
        android:tag=".icon.for-emojify-key"
        android:background="@drawable/APKTOOL_DUMMYVAL_0x7f0803c0"
        android:duplicateParentState="true"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="centerInside"
        android:contentDescription="@null"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b027c"
        android:tag=".background-icon.for-emojify-key.progress-circle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:max="360"
        android:progressDrawable="@drawable/APKTOOL_DUMMYVAL_0x7f080376"
        android:importantForAccessibility="no"
        style="?android:attr/progressBarStyleHorizontal"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b027d"
        android:tag=".background-icon.for-emojify-key.second-progress-circle"
        android:background="@drawable/APKTOOL_DUMMYVAL_0x7f080375"
        android:visibility="invisible"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:max="360"
        android:progressDrawable="@drawable/APKTOOL_DUMMYVAL_0x7f080374"
        android:importantForAccessibility="no"
        style="?android:attr/progressBarStyleHorizontal"/>
</FrameLayout>
