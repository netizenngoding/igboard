<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/APKTOOL_DUMMYVAL_0x7f1509d2"
    android:orientation="horizontal"
    android:tag=".jarvis-prompt-search-box.jarvis-prompt-edit-text-holder"
    android:background="@color/APKTOOL_DUMMYVAL_0x7f060b88"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false">
    <FrameLayout
        android:gravity="center_vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:layout_weight="1">
        <com.google.android.libraries.inputmethod.widgets.EditTextOnKeyboard
            android:textAppearance="?attr/APKTOOL_DUMMYVAL_0x7f040a4c"
            android:textStyle="italic"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b044c"
            android:tag=".label.writing-tools-search-input-text"
            android:background="@null"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foreground="@drawable/APKTOOL_DUMMYVAL_0x7f08060f"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:inputType="textCapSentences"
            android:paddingStart="18dp"
            android:paddingEnd="0dp"
            app:APKTOOL_DUMMYVAL_0x7f040396="true"/>
    </FrameLayout>
    <FrameLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b0447"
        android:tag=".jarvis_prompt-action-icon-background"
        android:background="@drawable/APKTOOL_DUMMYVAL_0x7f080298"
        android:layout_width="?attr/APKTOOL_DUMMYVAL_0x7f0400a4"
        android:layout_height="?attr/APKTOOL_DUMMYVAL_0x7f0400a4"
        android:contentDescription="@string/APKTOOL_DUMMYVAL_0x7f140554"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="9dp"
        android:tooltipText="@string/APKTOOL_DUMMYVAL_0x7f140554">
        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:tag=".jarvis-prompt-action-icon"
            android:layout_width="@dimen/APKTOOL_DUMMYVAL_0x7f0700e0"
            android:layout_height="@dimen/APKTOOL_DUMMYVAL_0x7f0700e0"
            android:src="@drawable/APKTOOL_DUMMYVAL_0x7f0803fd"
            android:scaleType="centerInside"/>
    </FrameLayout>
</LinearLayout>
