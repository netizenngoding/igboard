        android:layout_gravity="end|center_vertical"
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b01b9"
        android:tag=".banner-tooltip-foreground"
        android:background="@drawable/APKTOOL_DUMMYVAL_0x7f080293"
        android:padding="14dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/APKTOOL_DUMMYVAL_0x7f0806b3"
        android:contentDescription="@string/APKTOOL_DUMMYVAL_0x7f1404f5"
        android:layout_marginHorizontal="6dp"/>
