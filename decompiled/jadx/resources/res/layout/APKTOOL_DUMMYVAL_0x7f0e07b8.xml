    android:orientation="horizontal"
    android:tag=".banner-tooltip-background"
    android:background="?attr/APKTOOL_DUMMYVAL_0x7f04002d"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="?attr/APKTOOL_DUMMYVAL_0x7f0401fd"
    android:paddingEnd="?attr/APKTOOL_DUMMYVAL_0x7f0401fc"
    android:paddingVertical="10dp">
