<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/APKTOOL_DUMMYVAL_0x7f0803a6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">
    <ImageView
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b01fc"
        android:background="@drawable/APKTOOL_DUMMYVAL_0x7f0803a5"
        android:duplicateParentState="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"/>
    <ImageView
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b01fa"
        android:tag=".custom-sticker-image-ps-badge"
        android:background="@drawable/APKTOOL_DUMMYVAL_0x7f08028f"
        android:padding="4dp"
        android:duplicateParentState="true"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_margin="2dp"
        android:src="@drawable/APKTOOL_DUMMYVAL_0x7f080689"
        android:scaleType="fitCenter"
        android:layout_alignParentTop="true"
        android:importantForAccessibility="no"
        android:layout_alignParentEnd="true"
        android:backgroundTint="?attr/APKTOOL_DUMMYVAL_0x7f0404e0"/>
    <ImageView
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b01fb"
        android:tag=".custom-sticker-image-selected-badge"
        android:background="@drawable/APKTOOL_DUMMYVAL_0x7f0803a7"
        android:padding="2dp"
        android:duplicateParentState="true"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_margin="2dp"
        android:src="@drawable/APKTOOL_DUMMYVAL_0x7f0803a8"
        android:scaleType="fitCenter"
        android:tint="?attr/APKTOOL_DUMMYVAL_0x7f0404aa"
        android:layout_alignParentTop="true"
        android:importantForAccessibility="no"
        android:layout_alignParentEnd="true"
        android:backgroundTint="?attr/APKTOOL_DUMMYVAL_0x7f0404cc"/>
    <com.google.android.material.loadingindicator.LoadingIndicator
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b01f9"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
</RelativeLayout>
