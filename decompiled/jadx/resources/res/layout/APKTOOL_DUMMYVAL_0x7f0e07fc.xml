<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag=".keyboard-header-area"
    android:background="?attr/APKTOOL_DUMMYVAL_0x7f04002d"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b2a3b"
        android:layout_width="@dimen/APKTOOL_DUMMYVAL_0x7f0709ca"
        android:layout_height="@dimen/APKTOOL_DUMMYVAL_0x7f0709ca"
        android:src="@drawable/APKTOOL_DUMMYVAL_0x7f0806b3"
        android:scaleType="center"
        android:tint="@color/APKTOOL_DUMMYVAL_0x7f0608c6"
        android:contentDescription="@string/APKTOOL_DUMMYVAL_0x7f141683"
        android:layout_marginStart="8dp"
        style="?android:attr/borderlessButtonStyle"/>
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_weight="1">
        <TextView
            android:gravity="center"
            android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b2a3d"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/APKTOOL_DUMMYVAL_0x7f150cf8"/>
    </ScrollView>
    <com.google.android.libraries.inputmethod.widgets.RingAnimationView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b2a3c"
        android:layout_width="@dimen/APKTOOL_DUMMYVAL_0x7f0709bd"
        android:layout_height="@dimen/APKTOOL_DUMMYVAL_0x7f0709bd"
        android:contentDescription="@string/APKTOOL_DUMMYVAL_0x7f141684"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="6dp"
        app:APKTOOL_DUMMYVAL_0x7f04080a="@dimen/APKTOOL_DUMMYVAL_0x7f0709bd"
        app:APKTOOL_DUMMYVAL_0x7f040889="@dimen/APKTOOL_DUMMYVAL_0x7f0709bc">
        <ImageView
            android:layout_gravity="center"
            android:tag=".background-icon.for-mic-protection"
            android:layout_width="@dimen/APKTOOL_DUMMYVAL_0x7f0709bc"
            android:layout_height="@dimen/APKTOOL_DUMMYVAL_0x7f0709bc"
            android:src="@drawable/APKTOOL_DUMMYVAL_0x7f08028f"
            android:importantForAccessibility="no"/>
        <ImageView
            android:layout_gravity="center"
            android:tag=".icon.for-header-icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/APKTOOL_DUMMYVAL_0x7f0805bd"
            android:importantForAccessibility="no"/>
    </com.google.android.libraries.inputmethod.widgets.RingAnimationView>
</LinearLayout>
