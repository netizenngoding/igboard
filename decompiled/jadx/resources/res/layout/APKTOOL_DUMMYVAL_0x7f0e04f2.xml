<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/APKTOOL_DUMMYVAL_0x7f1501f3">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="114">
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView
            android:id="@+id/key_pos_shift"
            android:layout_weight="38"
            style="@style/APKTOOL_DUMMYVAL_0x7f1506e5">
            <LinearLayout
                android:orientation="vertical"
                android:duplicateParentState="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:weightSum="800">
                <FrameLayout
                    android:id="@+id/host"
                    android:paddingTop="?attr/APKTOOL_DUMMYVAL_0x7f040250"
                    android:visibility="invisible"
                    android:duplicateParentState="true"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="600"/>
                <ImageView
                    android:src="@drawable/APKTOOL_DUMMYVAL_0x7f0802fe"
                    android:layout_weight="200"
                    style="@style/APKTOOL_DUMMYVAL_0x7f1504a7"/>
            </LinearLayout>
        </com.google.android.libraries.inputmethod.widgets.SoftKeyView>
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView
            android:id="@+id/key_pos_morse_hint_card"
            android:visibility="gone"
            android:layout_weight="38"
            style="@style/APKTOOL_DUMMYVAL_0x7f1506e5">
            <LinearLayout
                android:orientation="vertical"
                android:duplicateParentState="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:weightSum="800">
                <FrameLayout
                    android:id="@+id/host"
                    android:paddingTop="?attr/APKTOOL_DUMMYVAL_0x7f040250"
                    android:visibility="invisible"
                    android:duplicateParentState="true"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="600"/>
                <ImageView
                    android:src="@drawable/APKTOOL_DUMMYVAL_0x7f0802fc"
                    android:layout_weight="200"
                    style="@style/APKTOOL_DUMMYVAL_0x7f1504a7"/>
            </LinearLayout>
        </com.google.android.libraries.inputmethod.widgets.SoftKeyView>
        <com.google.android.libraries.inputmethod.widgets.SoftKeyView xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/key_pos_switch_to_next_language"
            android:visibility="gone"
            android:layout_weight="38"
            app:APKTOOL_DUMMYVAL_0x7f04038f="true"
            style="@style/APKTOOL_DUMMYVAL_0x7f1506e5">
            <LinearLayout
                android:gravity="top"
                android:orientation="vertical"
                android:duplicateParentState="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:weightSum="800">
                <FrameLayout
                    android:id="@+id/host"
                    android:visibility="invisible"
                    android:duplicateParentState="true"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="?attr/APKTOOL_DUMMYVAL_0x7f040257"/>
            </LinearLayout>
        </com.google.android.libraries.inputmethod.widgets.SoftKeyView>
    </LinearLayout>
    <com.google.android.libraries.inputmethod.widgets.SoftKeyView
        android:id="@+id/key_pos_space"
        android:layout_weight="126"
        style="@style/APKTOOL_DUMMYVAL_0x7f1506f3">
        <LinearLayout
            android:orientation="vertical"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="800">
            <FrameLayout
                android:id="@+id/host"
                android:paddingTop="?attr/APKTOOL_DUMMYVAL_0x7f040250"
                android:visibility="invisible"
                android:duplicateParentState="true"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="600"/>
            <ImageView
                android:src="@drawable/APKTOOL_DUMMYVAL_0x7f0802ff"
                android:layout_weight="200"
                style="@style/APKTOOL_DUMMYVAL_0x7f1504a7"/>
        </LinearLayout>
    </com.google.android.libraries.inputmethod.widgets.SoftKeyView>
    <com.google.android.libraries.inputmethod.widgets.SoftKeyView
        android:id="@+id/key_pos_del"
        android:layout_weight="57"
        style="@style/APKTOOL_DUMMYVAL_0x7f1506e5">
        <LinearLayout
            android:orientation="vertical"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="800">
            <FrameLayout
                android:id="@+id/host"
                android:paddingTop="?attr/APKTOOL_DUMMYVAL_0x7f040250"
                android:visibility="invisible"
                android:duplicateParentState="true"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="600"/>
            <ImageView
                android:src="@drawable/APKTOOL_DUMMYVAL_0x7f0802f8"
                android:layout_weight="200"
                style="@style/APKTOOL_DUMMYVAL_0x7f1504a7"/>
        </LinearLayout>
    </com.google.android.libraries.inputmethod.widgets.SoftKeyView>
    <com.google.android.libraries.inputmethod.widgets.SoftKeyView
        android:id="@+id/key_pos_ime_action"
        android:layout_weight="57"
        style="@style/APKTOOL_DUMMYVAL_0x7f1506ee"/>
</LinearLayout>
