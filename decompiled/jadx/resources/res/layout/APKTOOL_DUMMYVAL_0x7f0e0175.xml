<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="2dp"
    android:paddingTop="2dp"
    android:paddingRight="2dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b29c6"
        android:tag=".floating-tooltip-background"
        android:background="@drawable/APKTOOL_DUMMYVAL_0x7f080763"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">
        <TextView
            android:textSize="14dp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b29c7"
            android:tag=".floating-tooltip-foreground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="230dp"
            android:text="@string/APKTOOL_DUMMYVAL_0x7f14051c"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b29c5"
        android:tag=".floating-tooltip-triangle"
        android:layout_width="16dp"
        android:layout_height="9dp"
        android:src="@drawable/APKTOOL_DUMMYVAL_0x7f080762"
        android:scaleType="fitXY"
        android:layout_marginStart="16dp"
        android:elevation="2dp"/>
</LinearLayout>
