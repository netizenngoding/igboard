<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b0700"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:layout_gravity="center"
            android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b06ff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:hint="@string/APKTOOL_DUMMYVAL_0x7f14088c"
            android:maxLength="@integer/APKTOOL_DUMMYVAL_0x7f0c00c9"
            android:inputType="textNoSuggestions"
            android:imeOptions="flagNoFullscreen|actionNext"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:importantForAutofill="no">
            <requestFocus/>
        </EditText>
        <TextView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b06fe"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/APKTOOL_DUMMYVAL_0x7f14088b"
            android:layout_marginStart="10dp"
            style="?android:attr/textAppearanceSmall"/>
        <EditText
            android:layout_gravity="center"
            android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b06fd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/APKTOOL_DUMMYVAL_0x7f14088a"
            android:maxLength="@integer/APKTOOL_DUMMYVAL_0x7f0c00c9"
            android:inputType="textNoSuggestions"
            android:imeOptions="flagNoFullscreen|actionDone"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:importantForAutofill="no"/>
        <TextView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b06fb"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/APKTOOL_DUMMYVAL_0x7f140889"
            android:layout_marginStart="10dp"
            style="?android:attr/textAppearanceSmall"/>
        <Spinner
            android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b06fc"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/APKTOOL_DUMMYVAL_0x7f140889"
            android:textAlignment="viewStart"/>
    </LinearLayout>
</ScrollView>
