<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150"
    android:exitFadeDuration="200">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <size
                        android:height="28dp"
                        android:width="32dp"/>
                    <corners android:radius="14dp"/>
                    <gradient
                        android:startColor="#66ffffff"
                        android:endColor="#40ffffff"
                        android:angle="270"
                        android:centerColor="#1affffff"/>
                </shape>
            </item>
            <item
                android:left="5dp"
                android:top="2dp"
                android:right="5dp"
                android:bottom="14dp">
                <shape>
                    <corners android:radius="10dp"/>
                    <gradient
                        android:startColor="#b3ffffff"
                        android:endColor="#00ffffff"
                        android:angle="270"/>
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="14dp"/>
                    <stroke
                        android:width="1.5dp"
                        android:color="#e6ffffff"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:height="28dp"
                android:width="32dp">
                <shape>
                    <size
                        android:height="28dp"
                        android:width="32dp"/>
                    <solid android:color="#00000000"/>
                </shape>
            </item>
            <item
                android:left="2dp"
                android:top="2.5dp"
                android:right="2dp"
                android:bottom="1.5dp">
                <shape>
                    <corners android:radius="12dp"/>
                    <solid android:color="#22000000"/>
                </shape>
            </item>
            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape>
                    <corners android:radius="12dp"/>
                    <gradient
                        android:startColor="#ffffffff"
                        android:endColor="#ffededf2"
                        android:angle="270"/>
                    <stroke
                        android:width="0.5dp"
                        android:color="#14000000"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
