<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <size
                        android:height="28dp"
                        android:width="64dp"/>
                    <corners android:radius="14dp"/>
                    <solid android:color="#ff34c759"/>
                </shape>
            </item>
            <item
                android:left="3dp"
                android:top="1dp"
                android:right="3dp"
                android:bottom="12dp">
                <shape>
                    <corners android:radius="12dp"/>
                    <gradient
                        android:startColor="#55ffffff"
                        android:endColor="#00ffffff"
                        android:angle="270"/>
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="14dp"/>
                    <stroke
                        android:width="1dp"
                        android:color="#40ffffff"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <size
                        android:height="28dp"
                        android:width="64dp"/>
                    <corners android:radius="14dp"/>
                    <solid android:color="#5c787880"/>
                </shape>
            </item>
            <item
                android:left="3dp"
                android:top="1dp"
                android:right="3dp"
                android:bottom="12dp">
                <shape>
                    <corners android:radius="12dp"/>
                    <gradient
                        android:startColor="#33ffffff"
                        android:endColor="#00ffffff"
                        android:angle="270"/>
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="14dp"/>
                    <stroke
                        android:width="1dp"
                        android:color="#30ffffff"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
