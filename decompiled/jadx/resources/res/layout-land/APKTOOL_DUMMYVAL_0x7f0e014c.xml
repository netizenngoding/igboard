                style="@style/APKTOOL_DUMMYVAL_0x7f15063f"/>
            <TextView
                android:gravity="center_horizontal"
                android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b037c"
                android:text="@string/APKTOOL_DUMMYVAL_0x7f140430"
                style="@style/APKTOOL_DUMMYVAL_0x7f15063c"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2">
            <ImageView
                android:id="@+id/APKTOOL_DUMMYVAL_0x7f0b0381"
                android:layout_marginTop="14dp"
