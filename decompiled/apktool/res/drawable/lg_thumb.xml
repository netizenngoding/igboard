<?xml version="1.0" encoding="utf-8"?>
<selector android:enterFadeDuration="150" android:exitFadeDuration="200"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <size android:height="28.0dp" android:width="32.0dp" />
                    <corners android:radius="14.0dp" />
                    <gradient android:startColor="#66ffffff" android:endColor="#40ffffff" android:angle="270.0" android:centerColor="#1affffff" />
                </shape>
            </item>
            <item android:left="5.0dp" android:top="2.0dp" android:right="5.0dp" android:bottom="14.0dp">
                <shape>
                    <corners android:radius="10.0dp" />
                    <gradient android:startColor="#b3ffffff" android:endColor="#00ffffff" android:angle="270.0" />
                </shape>
            </item>
            <item>
                <shape>
                    <corners android:radius="14.0dp" />
                    <stroke android:width="1.5dp" android:color="#e6ffffff" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:height="28.0dp" android:width="32.0dp">
                <shape>
                    <size android:height="28.0dp" android:width="32.0dp" />
                    <solid android:color="#00000000" />
                </shape>
            </item>
            <item android:left="2.0dp" android:top="2.5dp" android:right="2.0dp" android:bottom="1.5dp">
                <shape>
                    <corners android:radius="12.0dp" />
                    <solid android:color="#22000000" />
                </shape>
            </item>
            <item android:left="2.0dp" android:top="2.0dp" android:right="2.0dp" android:bottom="2.0dp">
                <shape>
                    <corners android:radius="12.0dp" />
                    <gradient android:startColor="#ffffffff" android:endColor="#ffededf2" android:angle="270.0" />
                    <stroke android:width="0.5dp" android:color="#14000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
