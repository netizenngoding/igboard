<?xml version="1.0" encoding="utf-8"?>
<framework>
    <if split_keyboard_handedness_ja="right|left">
        <key_mapping state="EMOJI_AVAILABLE">
            <mapping key_id="@id/APKTOOL_DUMMYVAL_0x7f0b159f" view_id="@id/key_pos_switch_to_symbol" />
        </key_mapping>
        <if expressions="policy_transparency">
            <key_mapping>
                <mapping key_id="@id/APKTOOL_DUMMYVAL_0x7f0b2473" view_id="@id/key_pos_switch_to_smiley" />
                <mapping key_id="@id/APKTOOL_DUMMYVAL_0x7f0b159d" view_id="@id/key_pos_switch_to_emoticon" />
            </key_mapping>
        </if>
        <else_if expressions="hidden">
            <key_mapping>
                <mapping key_id="@id/APKTOOL_DUMMYVAL_0x7f0b0fe6" view_id="@id/key_pos_switch_to_smiley" />
                <mapping key_id="@id/APKTOOL_DUMMYVAL_0x7f0b0fe6" view_id="@id/key_pos_switch_to_emoticon" />
                <mapping key_id="@id/APKTOOL_DUMMYVAL_0x7f0b247f" view_id="@id/key_pos_switch_to_symbol" />
            </key_mapping>
        </else_if>
        <else>
            <key_mapping>
                <mapping key_id="@id/APKTOOL_DUMMYVAL_0x7f0b2472" view_id="@id/key_pos_switch_to_smiley" />
                <mapping key_id="@id/APKTOOL_DUMMYVAL_0x7f0b159c" view_id="@id/key_pos_switch_to_emoticon" />
            </key_mapping>
            <key_mapping state="EMOJI_AVAILABLE">
                <mapping key_id="@id/APKTOOL_DUMMYVAL_0x7f0b246f" view_id="@id/key_pos_switch_to_smiley" />
                <mapping key_id="@id/APKTOOL_DUMMYVAL_0x7f0b159b" view_id="@id/key_pos_switch_to_emoticon" />
            </key_mapping>
        </else>
    </if>
</framework>
